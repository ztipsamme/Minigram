@* Home.razor — startsidan för MiniGram *@

@page "/"

@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Text.Json.Serialization;
@using System.Net.Http.Headers
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> Logger
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="authbar">

    @if (!authChecked)
    {
        <span>Kontrollerar inloggning...</span>
    }
    else if (loggedIn)
    {
        <span>
            Inloggad som: <strong>@currentUser</strong>
        </span>

        <a href="/.auth/logout?post_logout_redirect_uri=/" class="logoutbutton">
            Logga ut
        </a>
    }
    else
    {
        <a href="/.auth/login/google?post_login_redirect_uri=/" class="loginbutton">
            Logga in med Google
        </a>
    }

</div>

<h2>Bilder</h2>

@if (laddar)
{
    <p>Hämtar bilder...</p>
}
else if (bilder.Count == 0)
{
    <p>Inga bilder ännu. Ladda upp den första!</p>
}
else
{
    <div class="bildgalleri">

        @foreach (var bild in bilder)
        {
            <div class="bildkort">

                <img src="@bild.TidsbegransadUrl" alt="@bild.Caption" />

                <div class="bildinfo">

                    <p class="caption">
                        @bild.Caption
                    </p>

                    <p class="taggar">
                        @string.Join(
                            " · ",
                            bild.Taggar.Select(t => $"#{t}")
                        )
                    </p>

                    <button class="raderaknapp" @onclick="() => RaderaBild(bild.Namn)">
                        Ta bort
                    </button>

                </div>
            </div>
        }

    </div>
}

<hr />

<h2>Ladda upp bild</h2>

<div class="uppladdningsformular">

    <div class="falt">

        <label>Bild</label>

        <InputFile OnChange="FilVald" accept="image/*" />

    </div>

    <div class="falt">

        <label>Caption</label>

        <input type="text" @bind="caption" placeholder="Beskriv bilden..." />

    </div>

    <div class="falt">

        <label>Taggar (kommaseparerade)</label>

        <input type="text" @bind="taggar" placeholder="semester, strand, sol" />

    </div>

    <button @onclick="LaddaUpp" disabled="@(valdFil == null || !loggedIn)">
        Ladda upp
    </button>

    @if (!string.IsNullOrEmpty(felmeddelande))
    {
        <p class="fel">
            @felmeddelande
        </p>
    }

</div>


@code {

    private List<Bild> bilder = new();

    private bool laddar = true;

    private string caption = "";

    private string taggar = "";

    private IBrowserFile? valdFil;

    private string? accessToken;
    private string felmeddelande = "";

    private bool loggedIn = false;

    private string currentUser = "";
    private bool authChecked = false;

    private HttpClient CreateApiClient()
{
    return HttpClientFactory.CreateClient("MinGramApi");
}

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await KontrolleraInloggning();
            authChecked = true;

            await HamtaBilder();

            StateHasChanged();
        }
    }

   


    private async Task KontrolleraInloggning()
{
    try
    {
        Console.WriteLine("=== KONTROLLERAR INLOGGNING ===");

        var users = await JS.InvokeAsync<List<AuthUser>>(
            "fetchAuthUser"
        );

        Console.WriteLine($"Antal Easy Auth users: {users?.Count ?? 0}");

        var user = users?.FirstOrDefault();

        if (string.IsNullOrWhiteSpace(user?.UserId))
        {
            Console.WriteLine("INGEN INLOGGAD ANVÄNDARE");

            loggedIn = false;
            currentUser = "";
            accessToken = null;

            return;
        }

        loggedIn = true;
        currentUser = user.UserId;
        accessToken = user.AccessToken;

        Console.WriteLine($"Easy Auth provider: {user.ProviderName}");
        Console.WriteLine($"User ID: {user.UserId}");
        Console.WriteLine(
            $"Access token exists: {!string.IsNullOrEmpty(user.AccessToken)}"
        );

        // =========================================================
        // TOKEN DEBUG
        // =========================================================

        Console.WriteLine("=== TOKEN DEBUG START ===");

        if (string.IsNullOrWhiteSpace(accessToken))
        {
            Console.WriteLine("TOKEN IS NULL OR EMPTY");
        }
        else
        {
            Console.WriteLine($"TOKEN LENGTH: {accessToken.Length}");

            var parts = accessToken.Split('.');

            Console.WriteLine($"TOKEN PARTS: {parts.Length}");

            if (parts.Length == 3)
            {
                Console.WriteLine("TOKEN LOOKS LIKE JWT");

                try
                {
                    var payload = parts[1]
                        .Replace('-', '+')
                        .Replace('_', '/');

                    while (payload.Length % 4 != 0)
                    {
                        payload += "=";
                    }

                    var bytes = Convert.FromBase64String(payload);

                    var json = System.Text.Encoding.UTF8.GetString(bytes);

                    Console.WriteLine($"TOKEN PAYLOAD: {json}");

                    using var doc =
                        System.Text.Json.JsonDocument.Parse(json);

                    if (doc.RootElement.TryGetProperty(
                        "iss",
                        out var issuer))
                    {
                        Console.WriteLine(
                            $"TOKEN ISSUER: {issuer}"
                        );
                    }
                    else
                    {
                        Console.WriteLine(
                            "TOKEN ISSUER: <not present>"
                        );
                    }

                    if (doc.RootElement.TryGetProperty(
                        "aud",
                        out var audience))
                    {
                        Console.WriteLine(
                            $"TOKEN AUDIENCE: {audience}"
                        );
                    }
                    else
                    {
                        Console.WriteLine(
                            "TOKEN AUDIENCE: <not present>"
                        );
                    }

                    if (doc.RootElement.TryGetProperty(
                        "exp",
                        out var expiration))
                    {
                        Console.WriteLine(
                            $"TOKEN EXPIRATION: {expiration}"
                        );
                    }
                    else
                    {
                        Console.WriteLine(
                            "TOKEN EXPIRATION: <not present>"
                        );
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine(
                        $"TOKEN DECODE ERROR: {ex.Message}"
                    );
                }
            }
            else
            {
                Console.WriteLine(
                    "TOKEN IS NOT A 3-PART JWT"
                );
            }
        }

        Console.WriteLine("=== TOKEN DEBUG END ===");
    }
    catch (Exception ex)
    {
        Logger.LogError(
            ex,
            "Kunde inte kontrollera inloggningen."
        );

        Console.WriteLine(
            $"AUTH ERROR: {ex.Message}"
        );

        loggedIn = false;
        currentUser = "";
        accessToken = null;
    }
}


    private async Task HamtaBilder()
{
    try
    {
        var client = CreateApiClient();

Console.WriteLine("=== HÄMTAR BILDER ===");
Console.WriteLine($"API: {client.BaseAddress}");
Console.WriteLine($"Token finns: {!string.IsNullOrWhiteSpace(accessToken)}");

if (string.IsNullOrWhiteSpace(accessToken))
{
    Console.WriteLine("INGEN ACCESS TOKEN");
    return;
}

client.DefaultRequestHeaders.Authorization =
    new System.Net.Http.Headers.AuthenticationHeaderValue(
        "Bearer",
        accessToken
    );

Console.WriteLine("Bearer token tillagd.");

var response = await client.GetAsync("/bilder");

        Console.WriteLine($"API STATUS: {(int)response.StatusCode} {response.StatusCode}");

        var body = await response.Content.ReadAsStringAsync();

        Console.WriteLine($"API RESPONSE: {body}");

        if (!response.IsSuccessStatusCode)
        {
            Console.WriteLine("=== API-ANROP MISSLYCKADES ===");
            return;
        }

        var apiBilder =
            System.Text.Json.JsonSerializer.Deserialize<List<ApiBild>>(body);

        bilder = apiBilder?
            .Select(b => new Bild(
                
                b.Namn,
                b.Caption,
                b.Taggar,
                b.Url))
            .ToList() ?? new();

        Console.WriteLine($"Antal bilder: {bilder.Count}");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"=== API ERROR ===");
        Console.WriteLine(ex.ToString());
    }
}


    private void FilVald(InputFileChangeEventArgs e)
    {
        valdFil = e.File;

        felmeddelande = "";
    }


    private async Task LaddaUpp()
    {
        if (!loggedIn)
        {
            felmeddelande =
                "Du måste vara inloggad för att ladda upp en bild.";

            return;
        }

        if (valdFil == null)
        {
            felmeddelande =
                "Välj en bild först.";

            return;
        }

        try
        {
            var client = CreateApiClient();

            using var content =
                new MultipartFormDataContent();

            /*
             * Max 10 MB.
             *
             * Change this if your API allows larger files.
             */

            var stream =
                valdFil.OpenReadStream(
                    maxAllowedSize: 10 * 1024 * 1024
                );

            var fileContent =
                new StreamContent(stream);

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(
                    valdFil.ContentType
                );

            content.Add(
                fileContent,
                "fil",
                valdFil.Name
            );

            content.Add(
                new StringContent(caption),
                "caption"
            );

            content.Add(
                new StringContent(taggar),
                "taggar"
            );

            var response =
                await client.PostAsync(
                    "/bilder",
                    content
                );

            if (response.IsSuccessStatusCode)
            {
                valdFil = null;

                caption = "";

                taggar = "";

                await HamtaBilder();
            }
            else
            {
                Logger.LogWarning(
                    "API returnerade HTTP {StatusCode} vid uppladdning.",
                    response.StatusCode
                );

                felmeddelande =
                    "Kunde inte ladda upp bilden.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Fel vid uppladdning av bild."
            );

            felmeddelande =
                "Ett fel uppstod vid uppladdningen.";
        }
    }


    private async Task RaderaBild(string namn)
    {
        if (!loggedIn)
        {
            felmeddelande =
                "Du måste vara inloggad.";

            return;
        }

        try
        {
            var client = CreateApiClient();

            var response =
                await client.DeleteAsync(
                    $"/bilder/{Uri.EscapeDataString(namn)}"
                );

            if (response.IsSuccessStatusCode)
            {
                bilder =
                    bilder
                        .Where(b => b.Namn != namn)
                        .ToList();
            }
            else
            {
                Logger.LogWarning(
                    "API returnerade HTTP {StatusCode} vid radering.",
                    response.StatusCode
                );

                felmeddelande =
                    "Kunde inte radera bilden.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Fel vid radering av bild {Namn}.",
                namn
            );

            felmeddelande =
                "Ett fel uppstod när bilden skulle raderas.";
        }
    }


    /*
     * Response from Azure App Service Authentication:
     *
     * [
     * {
     * "provider_name": "google",
     * "user_id": "...",
     * "user_claims": [
     * {
     * "typ": "email",
     * "val": "..."
     * }
     * ]
     * }
     * ]
     */

    private record AuthUser(
    [property: JsonPropertyName("provider_name")]
    string? ProviderName,

    [property: JsonPropertyName("user_id")]
    string? UserId,

    [property: JsonPropertyName("user_claims")]
    List<AuthClaim>? UserClaims,

    [property: JsonPropertyName("access_token")]
    string? AccessToken
    );

    private record AuthClaim(
    [property: JsonPropertyName("typ")]
    string? Type,

    [property: JsonPropertyName("val")]
    string? Value
    );


    private record ApiBild(
        int Id,
        string Namn,
        string Caption,
        List<string> Taggar,
        string Url
    );


    private record Bild(
        string Namn,
        string Caption,
        List<string> Taggar,
        string TidsbegransadUrl
    );
}


<style>
