        margin: 1.5rem 0 1rem;

        font-size: 1.2rem;

        color: #555;

        text-transform: uppercase;

        letter-spacing: 1px;

    }


    hr {

        border: none;

        border-top: 1px solid #eee;

        margin: 2rem 0;

    }

