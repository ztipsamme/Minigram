        background: none;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 0.3rem 0.75rem;
        cursor: pointer;
        color: #e53935;
        font-size: 0.8rem;
    }

    .raderaknapp:hover {
        background: #ffeaea;
    }

