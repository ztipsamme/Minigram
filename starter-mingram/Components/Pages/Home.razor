@* Home.razor — startsidan för MinGram
   En Blazor-komponent: HTML, C# och CSS i samma fil.

   Ny på Blazor? Läs igenom introduktionen först:
   → 35_natverk_sakerhet/notes/blazor_intro.md

   Din uppgift är att implementera de metoder som är markerade med TODO.
   Strukturen är klar — du fyller i HTTP-anropen mot ditt eget API. *@

@page "/"
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<Home> Logger

@* InteractiveServer = C#-koden körs på servern, UI uppdateras via WebSocket (SignalR).
   React-jämförelse: det finns ingen direkt motsvarighet — närmast är Next.js Server Components,
   men Blazor håller en live-anslutning öppen till servern istället för att rendera en gång. *@
@rendermode InteractiveServer

<div class="authbar">
    @if (loggedIn)
    {
        <span>Inloggad som: <strong>@currentUser</strong></span>

        <a href="/.auth/logout" class="logoutbutton">
            Logga ut
        </a>
    }
    else
    {
        <a href="/.auth/login/aad" class="loginbutton">
            Logga in
        </a>
    }
</div>

<h2>Bilder</h2>

@if (laddar)
{
    <p>Hämtar bilder...</p>
}
else if (bilder.Count == 0)
{
    <p>Inga bilder ännu. Ladda upp den första!</p>
}
else
{
    <div class="bildgalleri">
        @* @foreach loopar och renderar ett element per item — som .map() i React/JSX *@
        @foreach (var bild in bilder)
        {
            <div class="bildkort">
                <img src="@bild.TidsbegransadUrl" alt="@bild.Caption" />
                <div class="bildinfo">
                    <p class="caption">@bild.Caption</p>
                    <p class="taggar">
                        @string.Join(" · ", bild.Taggar.Select(t => $"#{t}"))
                    </p>
                    @* @onclick = onClick i React. Lambda med () => gör att vi kan skicka med argument. *@
                    <button class="raderaknapp" @onclick="() => RaderaBild(bild.Namn)">
                        Ta bort
                    </button>
                </div>
            </div>
        }
    </div>
}

<hr />

<h2>Ladda upp bild</h2>

<div class="uppladdningsformular">
    <div class="falt">
        <label>Bild</label>
        @* InputFile är Blazors komponent för filuppladdning *@
        <InputFile OnChange="FilVald" accept="image/*" />
    </div>
    <div class="falt">
        <label>Caption</label>
        @* @bind = controlled input i React: value={caption} onChange={e => setCaption(e.target.value)}
           Blazor gör båda riktningarna automatiskt med ett enda @bind. *@
        <input type="text" @bind="caption" placeholder="Beskriv bilden..." />
    </div>
    <div class="falt">
        <label>Taggar (kommaseparerade)</label>
        <input type="text" @bind="taggar" placeholder="semester, strand, sol" />
    </div>
    <button @onclick="LaddaUpp" disabled="@(valdFil == null)">
        Ladda upp
    </button>
    @if (!string.IsNullOrEmpty(felmeddelande))
    {
        <p class="fel">@felmeddelande</p>
    }
</div>

@code {
    private List<Bild> bilder = new();
    private bool laddar = true;
    private string caption = "";
    private string taggar = "";
    private IBrowserFile? valdFil;
    private string felmeddelande = "";

    private bool loggedIn = false;
    private string currentUser = "";

    protected override async Task OnInitializedAsync()
    {
        await KontrolleraInloggning();
        await HamtaBilder();
    }

    private async Task KontrolleraInloggning()
    {
        var demoUser = Environment.GetEnvironmentVariable("DemoUserEmail");

        if (!string.IsNullOrEmpty(demoUser))
        {
            currentUser = demoUser;
            loggedIn = true;
            return;
        }

        loggedIn = false;

        await Task.CompletedTask;
    }

    private async Task HamtaBilder()
    {
        laddar = true;
        felmeddelande = "";

        try
        {
            var client = HttpClientFactory.CreateClient("MinGramApi");

            var apiBilder =
                await client.GetFromJsonAsync<List<ApiBild>>("/bilder");

            bilder = apiBilder?
                .Select(b => new Bild(
                    b.Namn,
                    b.Caption,
                    b.Taggar,
                    b.Url
                ))
                .ToList() ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte hämta bilder från API:t");
            felmeddelande = "Kunde inte hämta bilder från API:t.";
        }
        finally
        {
            laddar = false;
        }
    }

    private void FilVald(InputFileChangeEventArgs e)
    {
        valdFil = e.File;
        felmeddelande = "";
    }

    private async Task LaddaUpp()
    {
        // TODO
    }

    private async Task RaderaBild(string namn)
    {
        // TODO
    }

    private record ApiBild(
        int Id,
        string Namn,
        string Caption,
        List<string> Taggar,
        string Url
    );

    private record Bild(
        string Namn,
        string Caption,
        List<string> Taggar,
        string TidsbegransadUrl
    );
}


