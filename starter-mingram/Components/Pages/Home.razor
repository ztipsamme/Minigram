        color: white;
    }

    .loginbutton:hover {
        background: #1877c9;
    }

    .logoutbutton {
        border: 1px solid #ddd;
        color: #555;
        background: white;
    }

    .logoutbutton:hover {
        background: #f5f5f5;
    }
</style>